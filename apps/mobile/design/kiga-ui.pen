        {
          "type": "text",
          "id": "t7VZhg",
          "name": "Section Subtitle",
          "fill": "$text-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Mantendo a estética minimalista monocromática original, mas corrigindo os 5 gargalos: (1) 3 botões pretos competindo na Home, (2) ausência de barra de progresso e botão Voltar consistente no Cadastro, (3) inputs sem borda/ícones de apoio, (4) PIN em caixa de texto comum, e (5) falta de explicação entre Login Local vs. Nuvem.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 15,
          "fontWeight": "normal"
        }
      ]
    },
