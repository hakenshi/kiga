{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "unicorn/no-empty-file": "off"
  },
  "ignorePatterns": [
    "dist/**",
    ".expo/**",
    "node_modules/**",
    "example/**"
  ],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  }
}