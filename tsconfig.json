{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/typescript-config/base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "apps/**/node_modules",
    "packages/**/node_modules",
    "dist",
    ".turbo",
    ".expo",
    "**/design/**",
    "**/*.pen"
  ]
}
