{
  "name": "kiga",
  "devDependencies": {
    "@kiga/oxlint-config": "workspace:*",
    "@kiga/typescript-config": "workspace:*",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7"
  },
  "dependencies": {
    "drizzle-zod": "^0.8.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "turbo dev --filter @kiga/mobile",
    "dev:api": "turbo dev --filter @kiga/api",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:e2e": "bun --filter @kiga/mobile test:e2e",
    "maestro:studio": "bun --filter @kiga/mobile maestro:studio",
    "db:generate": "bun --filter @kiga/api db:generate",
    "db:push": "bun --filter @kiga/api db:push",
    "db:migrate": "bun --filter @kiga/api db:migrate",
    "db:studio": "bun --filter @kiga/api db:studio",
    "db:mobile:generate": "bun --filter @kiga/mobile db:generate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
